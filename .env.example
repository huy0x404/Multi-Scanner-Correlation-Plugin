TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Dashboard runtime settings (loaded from .env, not editable on website)
MSCP_LANG=en
MSCP_RISK_MODE=realistic
MSCP_ANALYSIS_ENGINE=system
MSCP_AI_ENABLED=true

# AI provider key (optional) - Hugging Face Inference API
HF_API_KEY=

# Notification toggles
MSCP_TELEGRAM_ENABLED=false
MSCP_EMAIL_ENABLED=false

# Email (SMTP)
MSCP_SMTP_HOST=
MSCP_SMTP_PORT=587
MSCP_SMTP_USER=
MSCP_SMTP_PASS=
MSCP_SMTP_USE_TLS=true
MSCP_EMAIL_FROM=
MSCP_EMAIL_TO=